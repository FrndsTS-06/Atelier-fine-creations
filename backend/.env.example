# Backend Server Environment Variables (Placeholders Only)
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL or SQLite)
# Example PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Example SQLite: file:./dev.db
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/aurelien_db?schema=public"

# Authentication Security
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin
CORS_ORIGIN="http://localhost:5173"

# Default Initial Administrator
ADMIN_DEFAULT_EMAIL="admin@example.com"
ADMIN_DEFAULT_PASSWORD="your_secure_admin_password"
